# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=
ADMIN_USERNAME=admin
# Choose a unique password of at least 12 characters before initializing.
ADMIN_PASSWORD=
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=16777216
FLASK_DEBUG=0
# Local HTTP only. Use 1 when serving over HTTPS in production.
SESSION_COOKIE_SECURE=0
# Use shared storage (for example redis://localhost:6379/0) with multiple workers.
RATELIMIT_STORAGE_URI=memory://

# Enable only behind a trusted proxy that sets client-IP and scheme headers.
TRUST_PROXY_HEADERS=0

# Local development uses local images and SQLite by default.
STORAGE_BACKEND=local
REQUIRE_EXTERNAL_STORAGE=0
# For free cloud hosting, use Supabase PostgreSQL and its public image bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tailor-images
